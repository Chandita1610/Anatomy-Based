    except ValueError:
        metrics["macro_auc_ovr"] = float("nan")

    print(f"\n===== {split_name} =====")
    print(f"Accuracy:           {metrics['accuracy']*100:.2f}%")
    print(f"Balanced Accuracy:  {metrics['balanced_accuracy']*100:.2f}%")
    print(f"Macro Precision:    {metrics['macro_precision']:.4f}")
    print(f"Macro Recall:       {metrics['macro_recall']:.4f}")
    print(f"Macro F1:           {metrics['macro_f1']:.4f}")
    print(f"Macro Specificity:  {metrics['macro_specificity']:.4f}")
    print(f"Macro AUC-OVR:      {metrics['macro_auc_ovr']:.4f}")
    print(f"Cohen Kappa:        {metrics['cohen_kappa']:.4f}")
    print(f"MCC:                {metrics['mcc']:.4f}")

    print("\nPer-class metrics:")
    for i, name in enumerate(CLASS_NAMES):
        print(
            f"{name:>4s}: "
            f"Precision={precision[i]:.4f}, "
            f"Recall={recall[i]:.4f}, "
            f"F1={f1[i]:.4f}, "
            f"Specificity={specificity[i]:.4f}, "
            f"N={support[i]}"
        )

    print("\nConfusion matrix:")
    print(pd.DataFrame(cm, index=CLASS_NAMES, columns=CLASS_NAMES))

    return {
        "metrics": metrics,
        "confusion_matrix": cm,
        "precision": precision,
        "recall": recall,
        "f1": f1,
        "specificity": specificity,
        "y_true": y_true,
        "y_pred": y_pred,
        "probs": probs,
        "filenames": all_filenames,
        "paths": all_paths,
    }


