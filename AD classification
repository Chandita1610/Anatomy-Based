    )
    complexity_row = {
        "total_parameters_m": complexity["total_parameters"] / 1e6,
        "trainable_parameters_m": complexity["trainable_parameters"] / 1e6,
        "frozen_parameters_m": complexity["frozen_parameters"] / 1e6,
        "trainable_percent": complexity["trainable_percent"],
        **timing,
    }
    pd.DataFrame([complexity_row]).to_csv(
        output_dir / "model_complexity_and_inference.csv", index=False
    )

    return {
        "metrics": metrics,
        "cm": cm,
        "classwise": classwise,
        "ci": ci_df,
        "counterfactual_summary": cf_summary,
        "gradcam": gradcam_df,
