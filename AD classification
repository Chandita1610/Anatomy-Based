@torch.no_grad()
def evaluate_ensemble(model, checkpoints, loader, split_name="Test Ensemble"):
    model.eval()
    all_probs, all_labels, all_filenames, all_paths = [], [], [], []
    states = []
    for ckpt_path in checkpoints:
        ckpt = torch.load(ckpt_path, map_location=DEVICE, weights_only=False)
        states.append(ckpt["model_state"])

    for batch in tqdm(loader, desc=f"Evaluating {split_name}", leave=False):
        image = batch["image"].to(DEVICE, non_blocking=True)
        labels = batch["label"].cpu().numpy()
        seed_probs = []
        variants = [image]
        if USE_TTA:
            variants += [
                torch.roll(image, shifts=(2, 0), dims=(2, 3)),
                torch.roll(image, shifts=(-2, 0), dims=(2, 3)),
                torch.roll(image, shifts=(0, 2), dims=(2, 3)),
                torch.roll(image, shifts=(0, -2), dims=(2, 3)),
            ]
        for state in states:
            model.load_state_dict(state)
            probs_for_seed = []
            for v in variants:
                probs_for_seed.append(F.softmax(model(v)["logits"], dim=1))
            seed_probs.append(torch.stack(probs_for_seed).mean(dim=0))
        probs = torch.stack(seed_probs).mean(dim=0)
        all_probs.append(probs.cpu().numpy())
        all_labels.extend(labels)
        all_filenames.extend(list(batch["filename"]))
        all_paths.extend(list(batch["path"]))

    probs = np.concatenate(all_probs, axis=0)
    y_true = np.asarray(all_labels)
    y_pred = probs.argmax(axis=1)
    cm = confusion_matrix(y_true, y_pred, labels=np.arange(len(CLASS_NAMES)))
    precision, recall, f1, support = precision_recall_fscore_support(
        y_true, y_pred, labels=np.arange(len(CLASS_NAMES)), zero_division=0
    )
    specificity = []
    for i in range(len(CLASS_NAMES)):
        tp = cm[i, i]
        fn = cm[i, :].sum() - tp
        fp = cm[:, i].sum() - tp
        tn = cm.sum() - tp - fn - fp
        specificity.append(tn / (tn + fp) if (tn + fp) else 0.0)
    specificity = np.asarray(specificity)
    metrics = {
        "accuracy": accuracy_score(y_true, y_pred),
        "balanced_accuracy": balanced_accuracy_score(y_true, y_pred),
        "macro_precision": precision.mean(),
        "macro_recall": recall.mean(),
        "macro_f1": f1.mean(),
        "macro_specificity": specificity.mean(),
        "cohen_kappa": cohen_kappa_score(y_true, y_pred),
        "mcc": matthews_corrcoef(y_true, y_pred),
    }
    try:
        metrics["macro_auc_ovr"] = roc_auc_score(y_true, probs, multi_class="ovr", average="macro")
    except ValueError:
        metrics["macro_auc_ovr"] = float("nan")
    print(f"\n===== {split_name} =====")
    for k, v in metrics.items():
        print(f"{k}: {v*100:.2f}%" if k in {"accuracy", "balanced_accuracy"} else f"{k}: {v:.4f}")
    print("\nConfusion matrix:")
    print(pd.DataFrame(cm, index=CLASS_NAMES, columns=CLASS_NAMES))
    pred_df = pd.DataFrame({"filename": all_filenames, "path": all_paths, "true_label": y_true, "pred_label": y_pred})
    for i, name in enumerate(CLASS_NAMES):
        pred_df[f"prob_{name}"] = probs[:, i]
    pred_df.to_csv(OUTPUT_DIR / "ensemble_test_predictions.csv", index=False)
    return metrics, cm



