        ]
        correct = [
            i for i in class_indices
            if pred_lookup.get(str(dataset.paths[i]), -1) == class_idx
        ]
        incorrect = [
            i for i in class_indices
            if i not in correct
        ]
        candidates = []
        if correct:
            candidates.append((correct[0], "correct"))
        if incorrect:
            candidates.append((incorrect[0], "incorrect"))
        for i, tag in candidates:
            if i not in selected:
                selected.append(i)
                selected_tags[i] = tag
        # Fill remaining slots deterministically.
        for i in class_indices:
            if len([j for j in selected if int(dataset.labels[j]) == class_idx]) >= n_examples_per_class:
                break
            if i not in selected:
                selected.append(i)
                selected_tags[i] = "representative"

    target_layer = model.visual_encoder.scale28_proj
    cam_extractor = GradCAM(model, target_layer)
    rows = []

    try:
        for idx in selected:
            sample = dataset[idx]
            image = sample["image"].unsqueeze(0).to(DEVICE)

            # Grad-CAM uses the model's predicted class as the target.
            cam, probs, predicted_class = cam_extractor(
                image, target_class=None
            )

            faith = compute_gradcam_faithfulness(
                model, image, cam, predicted_class,
                top_fraction=top_fraction
            )

            cam_np = cam[0, 0].cpu().numpy()
            base = sample["image"].permute(1, 2, 0).cpu().numpy()
