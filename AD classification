class ScratchTextEncoder(nn.Module):
    """
    Small Transformer text encoder trained entirely from scratch.

    It is used only to encode the fixed semantic concept phrases.
    Token embeddings, positional embeddings, Transformer layers, and
    normalization parameters are all randomly initialized.
    """

    def __init__(
        self,
        vocab_size,
        text_dim=TEXT_DIM,
        max_len=32,
        num_layers=4,
        num_heads=6,
        mlp_dim=None,
        dropout=0.10,
    ):
        super().__init__()

        if text_dim % num_heads != 0:
            raise ValueError(
                f"text_dim={text_dim} must be divisible by "
                f"num_heads={num_heads}."
            )

        mlp_dim = mlp_dim or text_dim * 4

        self.token_embedding = nn.Embedding(vocab_size, text_dim)
        self.position_embedding = nn.Parameter(
            torch.randn(1, max_len, text_dim) * 0.02
        )

        encoder_layer = nn.TransformerEncoderLayer(
            d_model=text_dim,
            nhead=num_heads,
            dim_feedforward=mlp_dim,
            dropout=dropout,
            activation="gelu",
            batch_first=True,
            norm_first=True,
        )

        self.encoder = nn.TransformerEncoder(
            encoder_layer,
            num_layers=num_layers,
        )

        self.norm = nn.LayerNorm(text_dim)
        self.max_len = max_len

        self._reset_parameters()

    def _reset_parameters(self):
        nn.init.normal_(self.token_embedding.weight, mean=0.0, std=0.02)

    def forward(self, token_ids, attention_mask):
        if token_ids.size(1) > self.max_len:
            raise ValueError(
                f"Sequence length {token_ids.size(1)} exceeds "
                f"max_len={self.max_len}."
            )

        x = self.token_embedding(token_ids)
        x = x + self.position_embedding[:, :x.size(1)]

        # TransformerEncoder expects True at padded positions.
        padding_mask = attention_mask == 0
        x = self.encoder(x, src_key_padding_mask=padding_mask)
        x = self.norm(x)

        mask = attention_mask.unsqueeze(-1).float()
        x = (x * mask).sum(dim=1)
        x = x / mask.sum(dim=1).clamp_min(1.0)

        return x


class MedicalSemanticBank(nn.Module):
    """
    Trainable semantic prototype bank initialized entirely from scratch.

    The phrases are fixed semantic concepts, but their embeddings are
    learned during MRI classification training. There is no pretrained
    language model and no external language-model checkpoint.
    """

    def __init__(self):
        super().__init__()

        all_phrases = []
        self.region_phrase_indices = {}

        for region in REGION_NAMES:
            start = len(all_phrases)
            all_phrases.extend(REGION_CONCEPTS[region])
            end = len(all_phrases)
            self.region_phrase_indices[region] = list(range(start, end))

        disease_start = len(all_phrases)
        all_phrases.extend(DISEASE_CONCEPTS)
        disease_indices = list(range(disease_start, len(all_phrases)))

        self.phrases = all_phrases
        self.vocab = self._build_vocab(all_phrases)

        self.text_encoder = ScratchTextEncoder(
            vocab_size=len(self.vocab),
            text_dim=TEXT_DIM,
            max_len=32,
            num_layers=4,
            num_heads=6,
            mlp_dim=TEXT_DIM * 4,
            dropout=0.10,
        )

        token_ids, attention_masks = self._encode_phrases(all_phrases)

        self.register_buffer(
            "phrase_token_ids",
            token_ids,
            persistent=True,
        )
        self.register_buffer(
            "phrase_attention_masks",
            attention_masks,
            persistent=True,
        )

        self.region_phrase_indices_tensor = {
            k: torch.tensor(v, dtype=torch.long)
            for k, v in self.region_phrase_indices.items()
        }

        self.disease_indices = torch.tensor(
            disease_indices,
            dtype=torch.long,
        )

    @staticmethod
    def _tokenize_phrase(phrase):
        # Simple deterministic word/subword-like tokenizer.
        # The vocabulary is learned only from the fixed concept strings.
        return re.findall(r"[a-z]+", phrase.lower())

    def _build_vocab(self, phrases):
        vocab = {
            "[PAD]": 0,
            "[UNK]": 1,
        }

        for phrase in phrases:
            for token in self._tokenize_phrase(phrase):
                if token not in vocab:
                    vocab[token] = len(vocab)

        return vocab

    def _encode_phrases(self, phrases):
        max_len = 32
        token_ids = []
        attention_masks = []

        for phrase in phrases:
            tokens = self._tokenize_phrase(phrase)
            ids = [self.vocab.get(tok, self.vocab["[UNK]"])
                   for tok in tokens]

            ids = ids[:max_len]
            mask = [1] * len(ids)

            if len(ids) < max_len:
                pad_len = max_len - len(ids)
                ids.extend([self.vocab["[PAD]"]] * pad_len)
                mask.extend([0] * pad_len)

            token_ids.append(ids)
            attention_masks.append(mask)

        return (
            torch.tensor(token_ids, dtype=torch.long),
            torch.tensor(attention_masks, dtype=torch.long),
        )

    def _all_embeddings(self):
        embeddings = self.text_encoder(
            self.phrase_token_ids,
            self.phrase_attention_masks,
        )
        return F.normalize(embeddings, dim=-1)

    def region_embeddings(self, region, device):
        embeddings = self._all_embeddings()
        idx = self.region_phrase_indices_tensor[region].to(device)
        return embeddings[idx]

    def disease_embeddings(self, device):
        embeddings = self._all_embeddings()
        return embeddings[self.disease_indices.to(device)]

    def extra_repr(self):
        return (
            f"vocab_size={len(self.vocab)}, "
            f"phrases={len(self.phrases)}, "
            f"text_dim={TEXT_DIM}, "
            f"pretrained=False"
        )


