    from sklearn.preprocessing import label_binarize

    y_bin = label_binarize(y_true, classes=np.arange(len(CLASS_NAMES)))

    fig, ax = plt.subplots(figsize=(6, 5))
    aucs = {}
    for i, name in enumerate(CLASS_NAMES):
