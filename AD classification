    pd.DataFrame({
        "class": list(aucs.keys()),
        "auc": list(aucs.values())
    }).to_csv(Path(output_path).with_suffix(".csv"), index=False)

    return aucs, macro_auc


def bootstrap_confidence_intervals(y_true, probs, n_bootstrap=2000, seed=2026):
    """Nonparametric 95% bootstrap CIs for final held-out test metrics."""
    rng = np.random.RandomState(seed)
    y_true = np.asarray(y_true)
    probs = np.asarray(probs)
    n = len(y_true)
    pred = probs.argmax(axis=1)

    def metrics_for_indices(idx):
        yt = y_true[idx]
        pp = probs[idx]
        yp = pp.argmax(axis=1)

        precision, recall, f1, _ = precision_recall_fscore_support(
            yt, yp, labels=np.arange(len(CLASS_NAMES)), zero_division=0
        )

        cm = confusion_matrix(
            yt, yp, labels=np.arange(len(CLASS_NAMES))
        )
        specificity = []
        for i in range(len(CLASS_NAMES)):
            tp = cm[i, i]
            fn = cm[i, :].sum() - tp
            fp = cm[:, i].sum() - tp
            tn = cm.sum() - tp - fn - fp
            specificity.append(tn / (tn + fp) if (tn + fp) else 0.0)

        try:
            auc_value = roc_auc_score(
                yt, pp, multi_class="ovr", average="macro"
            )
        except ValueError:
            auc_value = np.nan

        return {
            "accuracy": accuracy_score(yt, yp),
            "balanced_accuracy": balanced_accuracy_score(yt, yp),
            "macro_precision": precision.mean(),
            "macro_recall": recall.mean(),
            "macro_f1": f1.mean(),
            "macro_specificity": np.mean(specificity),
            "macro_auc_ovr": auc_value,
        }

    point = metrics_for_indices(np.arange(n))
    samples = {k: [] for k in point}

    for _ in range(n_bootstrap):
        idx = rng.randint(0, n, size=n)
        m = metrics_for_indices(idx)
        for k, v in m.items():
            if np.isfinite(v):
                samples[k].append(v)

    rows = []
    for k, point_value in point.items():
        vals = np.asarray(samples[k], dtype=float)
        if len(vals):
            lo, hi = np.percentile(vals, [2.5, 97.5])
        else:
            lo, hi = np.nan, np.nan
        rows.append({
            "metric": k,
            "estimate": point_value,
            "ci95_lower": lo,
            "ci95_upper": hi,
        })

    return pd.DataFrame(rows)


