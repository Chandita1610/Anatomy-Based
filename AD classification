def count_parameters(model):
    """
    Count parameter tensors only. In PyTorch, a parameter is
    non-trainable here only when requires_grad=False.

    IMPORTANT:
    BatchNorm running_mean/running_var and other state buffers are
    NOT parameters. They are reported separately by count_model_state.
    """
    total = sum(p.numel() for p in model.parameters())
    trainable = sum(
        p.numel()
        for p in model.parameters()
        if p.requires_grad
    )
    frozen = total - trainable
    return total, trainable, frozen


def count_model_state(model):
    """Report parameter counts plus non-parameter buffers."""
    total_params, trainable_params, frozen_params = count_parameters(model)
    buffer_count = sum(b.numel() for b in model.buffers())
    return {
        "total_parameters": total_params,
        "trainable_parameters": trainable_params,
        "frozen_parameters": frozen_params,
        "non_parameter_buffers": buffer_count,
        "trainable_percent": (
            100.0 * trainable_params / total_params
            if total_params else 0.0
        ),
        "frozen_percent": (
            100.0 * frozen_params / total_params
            if total_params else 0.0
        ),
    }


def _file_sha256(path, chunk_size=1024 * 1024):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(chunk_size)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def audit_split_overlap(splits):
    """
    Verify that no exact file path occurs in more than one split and
    report exact byte-identical image duplicates across splits.

    This is an audit only; it does not change the requested split protocol.
    """
    split_sets = {
        split: set(splits[f"{split}_paths"])
        for split in ("train", "val", "test")
    }

    path_overlaps = {
        "train_val": sorted(split_sets["train"] & split_sets["val"]),
        "train_test": sorted(split_sets["train"] & split_sets["test"]),
        "val_test": sorted(split_sets["val"] & split_sets["test"]),
    }

    all_paths = []
    for split in ("train", "val", "test"):
        all_paths.extend(
            (split, p) for p in splits[f"{split}_paths"]
        )

    hashes = {}
    for split, path in all_paths:
        digest = _file_sha256(path)
        hashes.setdefault(digest, []).append((split, path))

    duplicate_groups = []
    for digest, items in hashes.items():
        split_names = sorted(set(s for s, _ in items))
        if len(split_names) > 1:
            duplicate_groups.append({
                "sha256": digest,
                "items": items,
            })

    print("\n===== SPLIT LEAKAGE AUDIT =====")
    print(
        f"Exact path overlaps: "
        f"train-val={len(path_overlaps['train_val'])}, "
        f"train-test={len(path_overlaps['train_test'])}, "
        f"val-test={len(path_overlaps['val_test'])}"
    )
    print(
        f"Byte-identical files crossing splits: "
        f"{len(duplicate_groups)} duplicate group(s)"
    )

    if any(path_overlaps.values()):
        raise RuntimeError(
            "The same file path appears in multiple splits. "
            "The split construction is invalid."
        )

    duplicate_rows = [
        {
            "sha256": d["sha256"],
            "split": split,
            "path": path,
        }
        for d in duplicate_groups
        for split, path in d["items"]
    ]
    pd.DataFrame(
        duplicate_rows,
        columns=["sha256", "split", "path"],
    ).to_csv(
        OUTPUT_DIR / "cross_split_duplicate_audit.csv",
        index=False,
    )

    if duplicate_groups:
        print(
            "WARNING: exact byte-identical images occur across splits. "
            "This can cause data leakage even when paths differ."
        )
    else:
        print("No exact byte-identical image files cross the splits.")

    return path_overlaps, duplicate_groups


