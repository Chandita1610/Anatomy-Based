IMG_EXTENSIONS = {".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff"}


def extract_label(filename):
    """Extract AD/CN/MCI directly from the filename prefix."""
    label_name = Path(filename).stem.split("_")[0].upper()

    if label_name not in LABEL_MAP:
        raise ValueError(
            f"Cannot infer label from filename: {filename}. "
            f"Expected filename beginning with AD_, CN_, or MCI_."
        )

    return LABEL_MAP[label_name]


def list_images(folder):
    folder = Path(folder)

    if not folder.exists():
        raise FileNotFoundError(f"Folder not found: {folder}")

    return sorted([
        p for p in folder.iterdir()
        if p.is_file() and p.suffix.lower() in IMG_EXTENSIONS
    ])


def load_and_split_folder(folder, seed=42):
    """
    Leakage-safe duplicate-aware split for one folder.

    This helper is retained for compatibility and diagnostics. The main
    experiment uses load_combined_duplicate_safe_split(), which performs
    ONE global split across both axial and coronal folders.

    Images that are byte-identical are treated as one group and all members
    of a group are assigned to the same partition.
    """
    return _duplicate_aware_split_paths(list_images(Path(folder)), seed=seed)


def _duplicate_aware_split_paths(image_paths, seed=42):
    """Split a list of image paths into approximately 80/10/10 partitions.

    Exact byte-identical files are grouped before allocation. Allocation is
    performed within each class so the split remains approximately stratified.
    """
    image_paths = list(image_paths)
    if not image_paths:
        raise RuntimeError("No images were found for splitting.")

    labels = np.asarray(
        [extract_label(Path(p).name) for p in image_paths],
        dtype=np.int64,
    )

    # Group exact byte-identical files.
    hash_groups = {}
    for idx, path in enumerate(image_paths):
        digest = _file_sha256(path)
        hash_groups.setdefault(digest, []).append(idx)

    groups = []
    for digest, idxs in hash_groups.items():
        group_labels = labels[idxs]
        if len(set(group_labels.tolist())) > 1:
            bad_paths = [str(image_paths[i]) for i in idxs]
            raise RuntimeError(
                "A byte-identical image occurs with different labels:\n"
                + "\n".join(bad_paths)
            )
        groups.append({
            "sha256": digest,
            "indices": idxs,
            "label": int(group_labels[0]),
            "size": len(idxs),
        })

    rng = np.random.RandomState(seed)
    split_indices = {"train": [], "val": [], "test": []}

    for class_id in range(len(CLASS_NAMES)):
        class_groups = [g for g in groups if g["label"] == class_id]
        rng.shuffle(class_groups)

        total = sum(g["size"] for g in class_groups)
        target_train = int(round(0.80 * total))
        target_val = int(round(0.10 * total))

        train_count = 0
        val_count = 0

        for group in class_groups:
            if train_count < target_train:
                destination = "train"
                train_count += group["size"]
            elif val_count < target_val:
                destination = "val"
                val_count += group["size"]
            else:
                destination = "test"
            split_indices[destination].extend(group["indices"])

    for split_name in split_indices:
        rng.shuffle(split_indices[split_name])

    image_paths = np.asarray([str(p) for p in image_paths], dtype=object)

    return {
        "train_paths": image_paths[split_indices["train"]].tolist(),
        "train_labels": labels[split_indices["train"]].tolist(),
        "val_paths": image_paths[split_indices["val"]].tolist(),
        "val_labels": labels[split_indices["val"]].tolist(),
        "test_paths": image_paths[split_indices["test"]].tolist(),
        "test_labels": labels[split_indices["test"]].tolist(),
    }


def load_combined_duplicate_safe_split(axial_folder, coronal_folder, seed=42):
    """Construct ONE global leakage-safe split over axial + coronal images.

    Axial and coronal images remain independent samples; they are not paired.
    The global duplicate grouping is important because an identical image can
    otherwise occur once in the axial directory and once in the coronal
    directory and be assigned to different partitions.
    """
    axial_paths = list_images(Path(axial_folder))
    coronal_paths = list_images(Path(coronal_folder))
    all_paths = axial_paths + coronal_paths

    if not all_paths:
        raise RuntimeError("No axial/coronal MRI images were found.")

    return _duplicate_aware_split_paths(all_paths, seed=seed)


def count_modalities_in_split(split):
    """Return axial/coronal counts for each partition for reporting."""
    counts = {}
    for split_name in ("train", "val", "test"):
        paths = split[f"{split_name}_paths"]
        axial = sum("ax_AD_CN_MCI" in str(Path(p).parent) for p in paths)
        coronal = sum("cr_AD_CN_MCI" in str(Path(p).parent) for p in paths)
        counts[split_name] = {
            "axial": int(axial),
            "coronal": int(coronal),
            "combined": int(len(paths)),
        }
    return counts


def verify_duplicate_groups_are_partition_safe(split):
    """Return duplicate groups and assert that no group crosses partitions."""
    hashes = {}
    for split_name in ("train", "val", "test"):
        for path in split[f"{split_name}_paths"]:
            digest = _file_sha256(path)
            hashes.setdefault(digest, []).append((split_name, path))

    cross_split = []
    for digest, items in hashes.items():
        split_names = sorted({s for s, _ in items})
        if len(split_names) > 1:
            cross_split.append({"sha256": digest, "items": items})

    if cross_split:
        raise RuntimeError(
            f"Duplicate-aware split failed: {len(cross_split)} "
            "byte-identical group(s) cross train/val/test."
        )

    return cross_split


class MRIDataset(Dataset):
    """Single-image dataset matching the original split protocol."""

    def __init__(self, paths, labels, train=False):
        self.paths = list(paths)
        self.labels = list(labels)
        self.transform = TRAIN_TRANSFORM if train else EVAL_TRANSFORM

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, idx):
        image = Image.open(self.paths[idx]).convert("RGB")
        image = self.transform(image)

        return {
            "image": image,
            "label": torch.tensor(
                int(self.labels[idx]),
                dtype=torch.long,
            ),
            "filename": Path(self.paths[idx]).name,
            "path": self.paths[idx],
        }


