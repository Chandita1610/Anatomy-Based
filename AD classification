def _holm_adjust(p_values):
    """Holm step-down correction for a list of p-values."""
    p = np.asarray(p_values, dtype=float)
    adjusted = np.full_like(p, np.nan)
    valid = np.isfinite(p)
    idx = np.where(valid)[0]
    if len(idx) == 0:
        return adjusted
    order = idx[np.argsort(p[idx])]
    m = len(order)
    running = 0.0
    for rank, original_idx in enumerate(order):
        value = min(1.0, (m - rank) * p[original_idx])
        running = max(running, value)
        adjusted[original_idx] = running
    return adjusted


def perform_wilcoxon_tests(ablation_df, output_dir, metrics=None):
    """
    Pairwise Wilcoxon signed-rank tests using the same random seeds for
    both configurations. Holm-adjusted p-values are also reported.
    """
    metrics = metrics or STAT_METRICS
    configs = sorted(ablation_df["experiment"].unique().tolist())
    rows = []

    for metric in metrics:
        metric_rows = []
        for i in range(len(configs)):
            for j in range(i + 1, len(configs)):
                a_name, b_name = configs[i], configs[j]
                a = ablation_df[ablation_df.experiment == a_name][["seed", metric]]
                b = ablation_df[ablation_df.experiment == b_name][["seed", metric]]
                merged = a.merge(b, on="seed", suffixes=("_a", "_b"))
                x = merged[f"{metric}_a"].to_numpy(float)
                y = merged[f"{metric}_b"].to_numpy(float)
                finite = np.isfinite(x) & np.isfinite(y)
                x = x[finite]
                y = y[finite]

                if len(x) < 2:
                    stat, p = np.nan, np.nan
                elif np.allclose(x, y):
                    stat, p = 0.0, 1.0
                else:
                    test = wilcoxon(x, y, alternative="two-sided", zero_method="wilcox", method="auto")
                    stat, p = float(test.statistic), float(test.pvalue)

                metric_rows.append({
                    "metric": metric,
                    "method_A": a_name,
                    "method_B": b_name,
                    "n_pairs": len(x),
                    "wilcoxon_statistic": stat,
                    "p_value": p,
                })

        pvals = [r["p_value"] for r in metric_rows]
        adj = _holm_adjust(pvals)
        for r, ap in zip(metric_rows, adj):
            r["p_value_holm"] = float(ap) if np.isfinite(ap) else np.nan
            r["significant_p05"] = bool(np.isfinite(ap) and ap < 0.05)
            rows.append(r)

    result = pd.DataFrame(rows)
    result.to_csv(output_dir / "wilcoxon_signed_rank_results.csv", index=False)
    return result


def perform_kruskal_wallis(ablation_df, output_dir, metrics=None):
    """Overall Kruskal-Wallis comparison across the four configurations."""
    metrics = metrics or STAT_METRICS
    configs = sorted(ablation_df["experiment"].unique().tolist())
    rows = []

    for metric in metrics:
        groups = []
        names = []
        for config in configs:
            values = ablation_df.loc[ablation_df.experiment == config, metric].dropna().to_numpy(float)
            if len(values):
                groups.append(values)
                names.append(config)

        if len(groups) >= 2:
            test = kruskal(*groups, nan_policy="omit")
            h, p = float(test.statistic), float(test.pvalue)
        else:
            h, p = np.nan, np.nan

        rows.append({
            "metric": metric,
            "configurations": " | ".join(names),
            "n_groups": len(groups),
            "kruskal_H": h,
            "p_value": p,
            "significant_p05": bool(np.isfinite(p) and p < 0.05),
        })

    result = pd.DataFrame(rows)
    result.to_csv(output_dir / "kruskal_wallis_results.csv", index=False)
    return result


def mcnemar_exact_test(y_true, pred_a, pred_b):
    """Exact two-sided McNemar test for paired classifier predictions."""
    y_true = np.asarray(y_true)
    pred_a = np.asarray(pred_a)
    pred_b = np.asarray(pred_b)

    correct_a = pred_a == y_true
    correct_b = pred_b == y_true

    both_correct = int(np.sum(correct_a & correct_b))
    a_correct_b_wrong = int(np.sum(correct_a & ~correct_b))
    a_wrong_b_correct = int(np.sum(~correct_a & correct_b))
    both_wrong = int(np.sum(~correct_a & ~correct_b))

    discordant = a_correct_b_wrong + a_wrong_b_correct
    if discordant == 0:
        p = 1.0
    else:
        p = float(binomtest(
            k=min(a_correct_b_wrong, a_wrong_b_correct),
            n=discordant,
            p=0.5,
            alternative="two-sided",
        ).pvalue)

    return {
        "both_correct": both_correct,
        "A_correct_B_wrong": a_correct_b_wrong,
        "A_wrong_B_correct": a_wrong_b_correct,
        "both_wrong": both_wrong,
        "discordant_pairs": discordant,
        "p_value": p,
        "significant_p05": p < 0.05,
    }


def collect_ablation_test_predictions(ablation_checkpoints, model, test_loader, output_dir):
    """
    Evaluate every ablation configuration/seed on the identical held-out
    test set. Both individual predictions and test-set metrics are saved.
    """
    prediction_records = []
    metric_records = []

    for seed in sorted(ablation_checkpoints):
        for config_name, checkpoint_path in ablation_checkpoints[seed].items():
            result = evaluate_single_checkpoint_with_tta(
                model, checkpoint_path, test_loader
            )

            y_true = np.asarray(result["y_true"], dtype=int)
            y_pred = np.asarray(result["y_pred"], dtype=int)
            filenames = result.get(
                "filenames",
                [f"sample_{i}" for i in range(len(y_true))],
            )
            paths = result.get("paths", [""] * len(y_true))

            for i in range(len(y_true)):
                prediction_records.append({
                    "seed": int(seed),
                    "experiment": config_name,
                    "filename": filenames[i],
                    "path": paths[i],
                    "y_true": int(y_true[i]),
                    "y_pred": int(y_pred[i]),
                })

            metric_row = {
                "seed": int(seed),
                "experiment": config_name,
            }
            metric_row.update({
                k: float(v) for k, v in result["metrics"].items()
            })
            metric_records.append(metric_row)

    prediction_df = pd.DataFrame(prediction_records)
    metric_df = pd.DataFrame(metric_records)

    prediction_df.to_csv(
        output_dir / "ablation_test_predictions.csv",
        index=False,
    )
    metric_df.to_csv(
        output_dir / "ablation_test_metrics.csv",
        index=False,
    )

    return prediction_df, metric_df


def perform_mcnemar_tests(prediction_df, output_dir):
    """
    Exact McNemar tests for all classifier pairs, separately for each seed.
    Predictions are therefore paired on exactly the same held-out images.
    """
    configs = sorted(prediction_df["experiment"].unique().tolist())
    rows = []

    for seed in sorted(prediction_df["seed"].unique()):
        sdf = prediction_df[prediction_df.seed == seed].copy()
        # Full path is used as the pairing key because filenames alone are
        # not guaranteed to be globally unique across axial/coronal folders.
        pivot = sdf.pivot(index="path", columns="experiment", values="y_pred")
        labels = sdf.drop_duplicates("path").set_index("path")["y_true"]

        for i in range(len(configs)):
            for j in range(i + 1, len(configs)):
                a_name, b_name = configs[i], configs[j]
                if a_name not in pivot.columns or b_name not in pivot.columns:
                    continue
                common = pivot[[a_name, b_name]].dropna()
                yt = labels.loc[common.index].to_numpy(int)
                pa = common[a_name].to_numpy(int)
                pb = common[b_name].to_numpy(int)
                test = mcnemar_exact_test(yt, pa, pb)
                rows.append({
                    "seed": int(seed),
                    "method_A": a_name,
                    "method_B": b_name,
                    "n_test_samples": len(common),
                    **test,
                })

    result = pd.DataFrame(rows)
    result.to_csv(output_dir / "mcnemar_results.csv", index=False)
    return result


