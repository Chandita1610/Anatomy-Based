            axes[0].set_title(
                f"True: {CLASS_NAMES[int(sample['label'])]}\n{case_tag}"
            )
            axes[0].axis("off")

            axes[1].imshow(base)
            axes[1].imshow(cam_np, alpha=0.45)
            axes[1].set_title(
                f"Grad-CAM: {CLASS_NAMES[predicted_class]}"
            )
            axes[1].axis("off")

            axes[2].imshow(cam_np)
            axes[2].set_title(
                f"Drop: {faith['confidence_drop_percent']:.2f} pp"
            )
            axes[2].axis("off")

            fig.tight_layout()
            fig.savefig(
                output_dir / f"{idx:04d}_{Path(sample['filename']).stem}_gradcam.png",
                dpi=300,
                bbox_inches="tight",
            )
            plt.close(fig)

            rows.append({
                "index": idx,
                "filename": sample["filename"],
                "true_class": CLASS_NAMES[int(sample["label"])],
                "predicted_class": CLASS_NAMES[predicted_class],
                "case_type": case_tag,
                "target_probability": float(probs[0, predicted_class]),
                **faith,
            })
    finally:
        cam_extractor.remove()

    df = pd.DataFrame(rows)
    df.to_csv(output_dir / "gradcam_faithfulness.csv", index=False)

    if len(df):
        summary = (
            df.groupby("true_class")["confidence_drop_percent"]
