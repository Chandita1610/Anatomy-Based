def benchmark_inference(model, loader, checkpoints, warmup=5, repeats=30):
    """
    Report parameter count and single-model inference latency.
    Latency is measured on one representative batch using the selected
    architecture; it is not used for model selection.
    """
    ckpt = torch.load(
        checkpoints[0], map_location=DEVICE, weights_only=False
    )
    model.load_state_dict(ckpt["model_state"])
    model.eval()

    batch = next(iter(loader))
    image = batch["image"].to(DEVICE, non_blocking=True)

    with torch.no_grad():
        for _ in range(warmup):
            _ = model(image)
        if DEVICE.type == "cuda":
            torch.cuda.synchronize()

        t0 = time.perf_counter()
        for _ in range(repeats):
            _ = model(image)
        if DEVICE.type == "cuda":
            torch.cuda.synchronize()
        elapsed = time.perf_counter() - t0

    ms_per_batch = 1000.0 * elapsed / repeats
    ms_per_image = ms_per_batch / image.shape[0]

    return {
        "batch_size": int(image.shape[0]),
        "inference_ms_per_batch": ms_per_batch,
        "inference_ms_per_image": ms_per_image,
        "images_per_second": 1000.0 / ms_per_image,
    }


class GradCAM:
    """
    Grad-CAM for the proposed visual encoder.

    Target layer:
        visual_encoder.scale28_proj

    This produces a 28x28 spatial activation map before the transformer
    tokenization pathway. The resulting CAM is upsampled to 224x224.

    The accompanying faithfulness score is a confidence-drop score:
        original target-class probability
        minus probability after masking the top 20% CAM pixels.

    No anatomical ground-truth masks are assumed, so IoU/Dice are NOT
    reported for Grad-CAM unless independent ROI annotations are available.
    """
    def __init__(self, model, target_layer):
        self.model = model
        self.target_layer = target_layer
        self.activations = None
        self.gradients = None

        self.forward_handle = target_layer.register_forward_hook(
            self._forward_hook
        )
        self.backward_handle = target_layer.register_full_backward_hook(
            self._backward_hook
        )

    def _forward_hook(self, module, inputs, output):
        self.activations = output

    def _backward_hook(self, module, grad_input, grad_output):
        self.gradients = grad_output[0]

    def remove(self):
        self.forward_handle.remove()
        self.backward_handle.remove()

    def __call__(self, image, target_class=None):
        self.model.zero_grad(set_to_none=True)
        out = self.model(image)
        logits = out["logits"]

        if target_class is None:
            target_class = int(logits.argmax(dim=1)[0].item())

        score = logits[:, target_class].sum()
        score.backward()

        activations = self.activations
        gradients = self.gradients

        weights = gradients.mean(dim=(-2, -1), keepdim=True)
        cam = (weights * activations).sum(dim=1, keepdim=True)
        cam = F.relu(cam)

        cam = F.interpolate(
            cam, size=image.shape[-2:], mode="bilinear", align_corners=False
        )

        cam_min = cam.amin(dim=(-2, -1), keepdim=True)
        cam_max = cam.amax(dim=(-2, -1), keepdim=True)
        cam = (cam - cam_min) / (cam_max - cam_min + 1e-8)

        probabilities = F.softmax(logits.detach(), dim=1)
        return cam.detach(), probabilities.detach(), target_class


def compute_gradcam_faithfulness(model, image, cam, target_class,
                                  top_fraction=0.20):
    """
    Confidence-drop faithfulness score in percentage points.
    Higher values mean the highlighted CAM pixels contribute more to
    the model's target-class confidence.

    The image is normalized with mean/std=0.5, so zero corresponds to
    the normalization midpoint used as the masking value.
    """
    model.eval()
    with torch.no_grad():
        original_prob = F.softmax(model(image)["logits"], dim=1)[
            0, target_class
        ].item()

        flat = cam.flatten(1)
        k = max(1, int(flat.shape[1] * top_fraction))
        top_idx = torch.topk(flat, k=k, dim=1).indices

        masked = image.clone()
        masked_flat = masked.view(masked.shape[0], masked.shape[1], -1)

        for c in range(masked_flat.shape[1]):
            masked_flat[:, c, top_idx[0]] = 0.0

        masked = masked_flat.view_as(image)
        masked_prob = F.softmax(model(masked)["logits"], dim=1)[
            0, target_class
        ].item()

    return {
        "original_target_probability": original_prob,
        "masked_target_probability": masked_prob,
        "confidence_drop": original_prob - masked_prob,
        "confidence_drop_percent": 100.0 * (original_prob - masked_prob),
    }


def save_gradcam_visualizations(model, dataset, output_dir,
                                n_examples_per_class=4,
                                top_fraction=0.20):
