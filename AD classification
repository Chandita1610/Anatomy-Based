@torch.no_grad()
def evaluate_counterfactual_evidence(model, loader, output_csv):
    model.eval()
    rows = []

    for batch in tqdm(loader, desc="Counterfactual analysis"):
        image = batch["image"].to(DEVICE)
        labels = batch["label"].to(DEVICE)

        outputs = model.counterfactual_region_logits(image)
        original = outputs["original"]

        true_idx = labels.view(-1, 1)
        original_true = original.gather(
            1,
            true_idx,
        ).squeeze(1)

        for region in REGION_NAMES:
            cf = outputs[region]
            cf_true = cf.gather(
                1,
                true_idx,
            ).squeeze(1)

            evidence = original_true - cf_true

            for i in range(len(evidence)):
                rows.append({
                    "filename": batch["filename"][i],
                    "path": batch["path"][i],
                    "true_class": CLASS_NAMES[labels[i].item()],
                    "region": region,
                    "counterfactual_evidence": float(
                        evidence[i].cpu()
                    ),
                })

    df = pd.DataFrame(rows)
    df.to_csv(output_csv, index=False)

    summary = (
        df.groupby("region")["counterfactual_evidence"]
        .agg(["mean", "std", "median"])
        .reset_index()
    )

    print("\nCounterfactual anatomical evidence:")
    print(summary)

    return df, summary


