# 10. ANATOMY-GROUNDED VISION-LANGUAGE MODEL
# ================================================================

class AnatomyGroundedVLModel(nn.Module):
    def __init__(
        self,
        semantic_bank,
        use_roi=True,
        use_language=True,
        use_region_dropout=True,
    ):
        super().__init__()

        self.use_roi = use_roi
        self.use_language = use_language
        self.use_region_dropout = use_region_dropout

        self.semantic_bank = semantic_bank
        self.visual_encoder = VisualEncoder()
        self.region_grounder = RegionLanguageGrounder()

        self.semantic_fusion = nn.Sequential(
            nn.Linear(VISION_DIM * 2, VISION_DIM),
            nn.GELU(),
            nn.Dropout(0.1),
            nn.Linear(VISION_DIM, VISION_DIM),
        )

        self.final_fusion = nn.Sequential(
            nn.Linear(VISION_DIM * 3, VISION_DIM),
            nn.GELU(),
            nn.Dropout(0.2),
            nn.Linear(VISION_DIM, VISION_DIM),
        )

        self.classifier = nn.Linear(VISION_DIM, len(CLASS_NAMES))

        self.visual_to_text = nn.Linear(VISION_DIM, TEXT_DIM)

    def disease_semantic_logits(self, visual_feature):
        text_proto = self.semantic_bank.disease_embeddings(
            visual_feature.device
        )

        visual = F.normalize(
            self.visual_to_text(visual_feature),
            dim=-1,
        )

        text_proto = F.normalize(text_proto, dim=-1)

        return (visual @ text_proto.t()) / TEMPERATURE

    def encode_image(self, image, region_keep=None, labels=None):
        out = self.visual_encoder(
            image,
            region_keep=region_keep,
        )

        if self.use_roi and self.use_language:
            # Full model: anatomically localized visual tokens are grounded
            # against the region-specific semantic concept bank.
            region_info = self.region_grounder(
                out["regions"],
                self.semantic_bank,
                labels=labels,
            )
            region_features = region_info["fused_regions"]
            region_align_loss = region_info["alignment_loss"]
            attribute_probs = region_info["attribute_probs"]
        elif self.use_roi and not self.use_language:
            # Language ablation: retain the learned visual ROI tokens but
            # remove all region-language grounding and its alignment loss.
            region_features = out["regions"]
            region_align_loss = out["global"].new_tensor(0.0)
            attribute_probs = None
        else:
            # ROI ablation: no region-specific representation is supplied.
            region_features = torch.zeros_like(out["regions"])
            region_align_loss = out["global"].new_tensor(0.0)
            attribute_probs = None

        return {
            **out,
            "region_features": region_features,
            "region_align_loss": region_align_loss,
            "attribute_probs": attribute_probs,
        }

    def forward(self, image, region_keep=None, labels=None):
        out = self.encode_image(
            image,
            region_keep=region_keep,
            labels=labels,
        )

        if self.use_language:
            region_summary = out["region_features"].mean(dim=1)

            semantic_feature = self.semantic_fusion(
                torch.cat(
                    [out["global"], region_summary],
                    dim=-1,
                )
            )

            final_feature = self.final_fusion(
                torch.cat(
                    [
                        out["global"],
                        region_summary,
                        semantic_feature,
                    ],
                    dim=-1,
                )
            )

            semantic_logits = self.disease_semantic_logits(final_feature)

            logits = (
                self.classifier(final_feature)
                + SEMANTIC_LOGIT_WEIGHT * semantic_logits
            )
        else:
            final_feature = self.final_fusion(
                torch.cat(
                    [
                        out["global"],
                        out["global"],
                        out["global"],
                    ],
                    dim=-1,
                )
            )

            semantic_logits = torch.zeros(
                image.shape[0],
                len(CLASS_NAMES),
                device=image.device,
            )

            logits = self.classifier(final_feature)

        return {
            "logits": logits,
            "semantic_logits": semantic_logits,
            "global_feature": out["global"],
            "region_features": out["region_features"],
            "region_align_loss": out["region_align_loss"],
            "roi_maps": out["roi_maps"],
            "attribute_probs": out["attribute_probs"],
        }

    @torch.no_grad()
    def counterfactual_region_logits(self, image):
        base = self.forward(image)
        outputs = {"original": base["logits"]}

        for region_idx, region_name in enumerate(REGION_NAMES):
            keep = torch.ones(
                image.size(0),
                3,
                device=image.device,
            )
            keep[:, region_idx] = 0.0

            cf = self.forward(
                image,
                region_keep=keep,
            )
            outputs[region_name] = cf["logits"]

        return outputs


# ================================================================
# 11. LOSS FUNCTIONS
# ================================================================

def classification_loss(logits, labels, class_weights=None):
    # Class-balanced CE + focal term. Class weights come from training labels only.
    ce = F.cross_entropy(logits, labels, weight=class_weights, label_smoothing=0.0)
    logp = F.log_softmax(logits, dim=1)
    p = logp.exp()
    pt = p.gather(1, labels.unsqueeze(1)).squeeze(1).clamp_min(1e-8)
    focal = (-((1.0 - pt) ** 1.5) * logp.gather(1, labels.unsqueeze(1)).squeeze(1)).mean()
    return 0.70 * ce + 0.30 * focal


def disease_semantic_loss(semantic_logits, labels):
    return F.cross_entropy(semantic_logits, labels)


def supervised_contrastive_loss(features, labels, temperature=0.10):
    """
    Supervised contrastive learning on the image representation.
    This uses only training labels and helps separate AD/CN/MCI clusters.
    """
    features = F.normalize(features, dim=-1)
    similarity = torch.matmul(features, features.t()) / temperature

    labels = labels.contiguous().view(-1, 1)
    positive_mask = torch.eq(labels, labels.T).float()

    logits_mask = torch.ones_like(positive_mask)
    logits_mask.fill_diagonal_(0)
    positive_mask = positive_mask * logits_mask

    logits = similarity - similarity.max(dim=1, keepdim=True).values.detach()
    exp_logits = torch.exp(logits) * logits_mask
    log_prob = logits - torch.log(exp_logits.sum(dim=1, keepdim=True).clamp_min(1e-8))

    positive_count = positive_mask.sum(dim=1)
    valid = positive_count > 0

    if not valid.any():
        return features.new_tensor(0.0)

    mean_log_prob_pos = (
        (positive_mask * log_prob).sum(dim=1) /
        positive_count.clamp_min(1.0)
    )

    return -mean_log_prob_pos[valid].mean()


def region_dropout_consistency_loss(
    model,
    image,
    original_logits,
    labels=None,
):
    B = image.size(0)

    region_idx = torch.randint(
        low=0,
        high=3,
        size=(B,),
        device=image.device,
    )

    keep = torch.ones(
        B,
        3,
        device=image.device,
    )

    keep[
        torch.arange(B, device=image.device),
        region_idx,
    ] = 0.0

    cf = model(
        image,
        region_keep=keep,
        labels=labels,
    )

    p = F.softmax(original_logits.detach(), dim=-1)
    log_q = F.log_softmax(cf["logits"], dim=-1)

    return F.kl_div(log_q, p, reduction="batchmean")


# ================================================================
# 12. AMP CONTEXT
# ================================================================

def autocast_context():
    if AMP_ENABLED:
        return torch.autocast(
            device_type="cuda",
            dtype=torch.float16,
        )
    return nullcontext()


# ================================================================
# 13. TRAINING
# ================================================================

def train_one_epoch(
    model,
    loader,
    optimizer,
    scaler,
    class_weights,
    epoch,
):
    model.train()

    total_loss = 0.0
    total_cls = 0.0
    total_region = 0.0
    total_semantic = 0.0
    total_cf = 0.0
    total_supcon = 0.0

    all_preds = []
    all_labels = []

    # Gradually introduce auxiliary objectives after the classifier has
    # learned a basic visual representation.
    ramp = min(1.0, epoch / max(1, WARMUP_EPOCHS))

    optimizer.zero_grad(set_to_none=True)

    for step, batch in enumerate(
        tqdm(loader, desc=f"Training epoch {epoch}", leave=False)
    ):
        image = batch["image"].to(DEVICE, non_blocking=True)
        labels = batch["label"].to(DEVICE, non_blocking=True)

        with autocast_context():
            out = model(image, labels=labels)

            cls_loss = classification_loss(
                out["logits"],
                labels,
                class_weights=class_weights,
            )

            region_loss = out["region_align_loss"]

            if model.use_language:
                semantic_loss = disease_semantic_loss(
                    out["semantic_logits"],
                    labels,
                )
            else:
                semantic_loss = out["logits"].new_tensor(0.0)

            if model.use_region_dropout and ramp > 0:
                cf_loss = region_dropout_consistency_loss(
                    model,
                    image,
                    out["logits"],
                    labels=labels,
                )
            else:
                cf_loss = out["logits"].new_tensor(0.0)

            supcon_loss = supervised_contrastive_loss(
                out["global_feature"],
                labels,
                temperature=TEMPERATURE,
            )

            loss = (
                cls_loss
                + ramp * LAMBDA_REGION_ALIGN * region_loss
                + ramp * LAMBDA_DISEASE_ALIGN * semantic_loss
                + ramp * LAMBDA_REGION_DROPOUT * cf_loss
                + ramp * LAMBDA_SUPCON * supcon_loss
            )

            loss_for_backward = loss / GRAD_ACCUM_STEPS

        scaler.scale(loss_for_backward).backward()

        if (
            (step + 1) % GRAD_ACCUM_STEPS == 0
            or (step + 1) == len(loader)
        ):
            scaler.unscale_(optimizer)
            torch.nn.utils.clip_grad_norm_(
                model.parameters(),
                max_norm=1.0,
            )
            scaler.step(optimizer)
            scaler.update()
            optimizer.zero_grad(set_to_none=True)

        total_loss += loss.item()
        total_cls += cls_loss.item()
        total_region += region_loss.item()
        total_semantic += semantic_loss.item()
        total_cf += cf_loss.item()
        total_supcon += supcon_loss.item()

        preds = out["logits"].argmax(dim=1)
        all_preds.extend(preds.detach().cpu().numpy())
        all_labels.extend(labels.detach().cpu().numpy())

    accuracy = accuracy_score(all_labels, all_preds) * 100.0

    return {
        "loss": total_loss / len(loader),
        "cls_loss": total_cls / len(loader),
        "region_loss": total_region / len(loader),
        "semantic_loss": total_semantic / len(loader),
        "cf_loss": total_cf / len(loader),
        "supcon_loss": total_supcon / len(loader),
        "accuracy": accuracy,
    }


@torch.no_grad()
def evaluate_with_tta(model, loader, split_name="Test"):
    """
    Deterministic TTA: original + small translations/scale perturbations.
    The TTA policy is fixed before evaluation and does not use test labels.
    """
    if not USE_TTA:
        return evaluate(model, loader, split_name)

    model.eval()

    all_logits = []
    all_probs = []
    all_preds = []
    all_labels = []
    all_filenames = []
    all_paths = []

    # The dataset already provides the deterministic base evaluation tensor.
    # TTA is performed in tensor space to avoid changing the split.
    for batch in tqdm(loader, desc=f"Evaluating {split_name} with TTA", leave=False):
        image = batch["image"].to(DEVICE, non_blocking=True)
        labels = batch["label"].to(DEVICE, non_blocking=True)

        variants = [
            image,
            torch.roll(image, shifts=(2, 0), dims=(2, 3)),
            torch.roll(image, shifts=(-2, 0), dims=(2, 3)),
            torch.roll(image, shifts=(0, 2), dims=(2, 3)),
            torch.roll(image, shifts=(0, -2), dims=(2, 3)),
        ]

        logits_list = []
        for variant in variants:
            logits_list.append(model(variant)["logits"])

        logits = torch.stack(logits_list, dim=0).mean(dim=0)
        probs = F.softmax(logits, dim=1)
        preds = probs.argmax(dim=1)

        all_logits.append(logits.detach().cpu().numpy())
        all_probs.append(probs.detach().cpu().numpy())
        all_preds.extend(preds.detach().cpu().numpy())
        all_labels.extend(labels.detach().cpu().numpy())
        all_filenames.extend(list(batch["filename"]))
        all_paths.extend(list(batch["path"]))

    logits = np.concatenate(all_logits, axis=0)
    probs = np.concatenate(all_probs, axis=0)
    y_true = np.asarray(all_labels)
    y_pred = np.asarray(all_preds)

    cm = confusion_matrix(
        y_true,
        y_pred,
        labels=np.arange(len(CLASS_NAMES)),
    )

    precision, recall, f1, support = precision_recall_fscore_support(
        y_true,
        y_pred,
        labels=np.arange(len(CLASS_NAMES)),
        zero_division=0,
    )

    specificity = []
    for i in range(len(CLASS_NAMES)):
        tp = cm[i, i]
        fn = cm[i, :].sum() - tp
        fp = cm[:, i].sum() - tp
        tn = cm.sum() - tp - fn - fp
        specificity.append(
            tn / (tn + fp) if (tn + fp) > 0 else 0.0
        )

    specificity = np.asarray(specificity)

    metrics = {
        "accuracy": accuracy_score(y_true, y_pred),
        "balanced_accuracy": balanced_accuracy_score(y_true, y_pred),
        "macro_precision": precision.mean(),
        "macro_recall": recall.mean(),
        "macro_f1": f1.mean(),
        "macro_specificity": specificity.mean(),
        "cohen_kappa": cohen_kappa_score(y_true, y_pred),
        "mcc": matthews_corrcoef(y_true, y_pred),
    }

    try:
        metrics["macro_auc_ovr"] = roc_auc_score(
            y_true, probs, multi_class="ovr", average="macro"
        )
    except ValueError:
        metrics["macro_auc_ovr"] = float("nan")

    print(f"\n===== {split_name} (TTA) =====")
    print(f"Accuracy:           {metrics['accuracy']*100:.2f}%")
    print(f"Balanced Accuracy:  {metrics['balanced_accuracy']*100:.2f}%")
    print(f"Macro Precision:    {metrics['macro_precision']:.4f}")
    print(f"Macro Recall:       {metrics['macro_recall']:.4f}")
    print(f"Macro F1:           {metrics['macro_f1']:.4f}")
    print(f"Macro Specificity:  {metrics['macro_specificity']:.4f}")
    print(f"Macro AUC-OVR:      {metrics['macro_auc_ovr']:.4f}")
    print(f"Cohen Kappa:        {metrics['cohen_kappa']:.4f}")
    print(f"MCC:                {metrics['mcc']:.4f}")

    print("\nConfusion matrix:")
    print(pd.DataFrame(cm, index=CLASS_NAMES, columns=CLASS_NAMES))

    return {
        "metrics": metrics,
        "confusion_matrix": cm,
        "precision": precision,
        "recall": recall,
        "f1": f1,
        "specificity": specificity,
        "y_true": y_true,
        "y_pred": y_pred,
        "probs": probs,
        "filenames": all_filenames,
        "paths": all_paths,
    }


