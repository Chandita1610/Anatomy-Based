def plot_confusion_matrix(cm, output_path, normalize=True):
    import matplotlib.pyplot as plt

    mat = cm.astype(float)
    if normalize:
        denom = mat.sum(axis=1, keepdims=True)
        mat = np.divide(mat, denom, out=np.zeros_like(mat), where=denom != 0)

    fig, ax = plt.subplots(figsize=(5.2, 4.4))
    im = ax.imshow(mat)
    ax.set_xticks(range(len(CLASS_NAMES)), CLASS_NAMES)
    ax.set_yticks(range(len(CLASS_NAMES)), CLASS_NAMES)
    ax.set_xlabel("Predicted class")
    ax.set_ylabel("True class")
    ax.set_title("Normalized Confusion Matrix")

    for i in range(len(CLASS_NAMES)):
        for j in range(len(CLASS_NAMES)):
            text_value = f"{mat[i, j]*100:.1f}%" if normalize else str(cm[i, j])
            ax.text(j, i, text_value, ha="center", va="center")

    fig.colorbar(im, ax=ax, fraction=0.046, pad=0.04)
    fig.tight_layout()
    fig.savefig(output_path, dpi=300, bbox_inches="tight")
    plt.close(fig)


