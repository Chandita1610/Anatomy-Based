def run_experiment(
    seed=42,
    experiment_name="full_model",
    use_roi=True,
    use_language=True,
    use_region_dropout=True,
    splits=None,
):
    print("\n" + "=" * 80)
    print(f"EXPERIMENT: {experiment_name}")
    print(f"SEED: {seed}")
    print("=" * 80)

    seed_everything(seed)

    # ------------------------------------------------------------
    # FIXED GLOBAL DATA-SPLITTING PROTOCOL
    # ------------------------------------------------------------
    # CRITICAL CORRECTION:
    # The split is created ONCE (seed 42) and then reused for every
    # training seed. A different split for each ensemble member would
    # allow a model trained under seed 123/2026 to see images that belong
    # to the seed-42 test set, causing test-set leakage.
    if splits is None:
        raise ValueError(
            "A fixed train/validation/test split must be supplied to "
            "run_experiment(). Create it once before the seed loop."
        )

    # A single global split is used for all experiments and all training seeds.
    # Axial and coronal images remain independent samples and are not paired.

    # Class weights are computed ONLY from the training labels.
    # Validation and test labels are never used to construct weights.
    train_label_array = np.asarray(splits["train_labels"], dtype=np.int64)
    train_counts = np.bincount(
        train_label_array,
        minlength=len(CLASS_NAMES),
    ).astype(np.float32)
    class_weights_np = (
        train_counts.sum() /
        (len(CLASS_NAMES) * np.maximum(train_counts, 1.0))
    )
    class_weights = torch.tensor(
        class_weights_np,
        dtype=torch.float32,
        device=DEVICE,
    )

    print(f"Training class counts: {train_counts.astype(int).tolist()}")
    print(f"Training class weights: {class_weights_np.tolist()}")

    print(
        f"Combined: train={len(splits['train_paths'])}, "
        f"val={len(splits['val_paths'])}, "
        f"test={len(splits['test_paths'])}"
    )

    manifest_rows = []

    for split_name in ("train", "val", "test"):
        for path, label in zip(
            splits[f"{split_name}_paths"],
            splits[f"{split_name}_labels"],
        ):
            manifest_rows.append({
                "split": split_name,
                "filename": Path(path).name,
                "path": path,
                "label": int(label),
                "class": CLASS_NAMES[int(label)],
            })

    pd.DataFrame(manifest_rows).to_csv(
        OUTPUT_DIR / f"split_manifest_seed{seed}.csv",
        index=False,
    )

    # ------------------------------------------------------------
    # Dataset and loaders
    # ------------------------------------------------------------
    train_dataset = MRIDataset(
        splits["train_paths"],
        splits["train_labels"],
        train=True,
    )

    val_dataset = MRIDataset(
        splits["val_paths"],
        splits["val_labels"],
        train=False,
    )

    test_dataset = MRIDataset(
        splits["test_paths"],
        splits["test_labels"],
        train=False,
    )

    train_labels_np = np.asarray(splits["train_labels"], dtype=np.int64)
    sampler_counts = np.bincount(train_labels_np, minlength=len(CLASS_NAMES)).astype(np.float32)
    sampler_class_weights = 1.0 / np.maximum(sampler_counts, 1.0)
    sampler_weights = sampler_class_weights[train_labels_np]
    train_sampler = WeightedRandomSampler(
        weights=torch.as_tensor(sampler_weights, dtype=torch.double),
        num_samples=len(train_dataset),
        replacement=True,
    )
    train_loader = DataLoader(
        train_dataset,
        batch_size=BATCH_SIZE,
        sampler=train_sampler,
        shuffle=False,
        num_workers=NUM_WORKERS,
        pin_memory=(DEVICE.type == "cuda"),
        persistent_workers=(NUM_WORKERS > 0),
    )

    val_loader = DataLoader(
        val_dataset,
        batch_size=BATCH_SIZE,
        shuffle=False,
        num_workers=NUM_WORKERS,
        pin_memory=(DEVICE.type == "cuda"),
        persistent_workers=(NUM_WORKERS > 0),
    )

    test_loader = DataLoader(
        test_dataset,
        batch_size=BATCH_SIZE,
        shuffle=False,
        num_workers=NUM_WORKERS,
        pin_memory=(DEVICE.type == "cuda"),
        persistent_workers=(NUM_WORKERS > 0),
    )

    semantic_bank = MedicalSemanticBank().to(DEVICE)

    model = AnatomyGroundedVLModel(
        semantic_bank=semantic_bank,
        use_roi=use_roi,
        use_language=use_language,
        use_region_dropout=use_region_dropout,
    ).to(DEVICE)

    param_report = count_model_state(model)
    total_params = param_report["total_parameters"]
    trainable_params = param_report["trainable_parameters"]
    frozen_params = param_report["frozen_parameters"]

    # Scratch-training requirement: all parameters are intentionally trainable.
    # Therefore frozen_parameters=0 is EXPECTED for this implementation.
    if frozen_params != 0:
        frozen_names = [
            name for name, param in model.named_parameters()
            if not param.requires_grad
        ]
        raise RuntimeError(
            "Scratch-training requirement violated. "
            f"{frozen_params} parameter values are frozen. "
            f"Examples: {frozen_names[:10]}"
        )

    print("\nTRAINING MODE: ENTIRE MODEL FROM SCRATCH")
    print("Pretrained visual weights: NO")
    print("Pretrained language weights: NO")
    print(f"Total parameters:          {total_params/1e6:.6f} M")
    print(f"Trainable parameters:      {trainable_params/1e6:.6f} M")
    print(f"Frozen parameters:          {frozen_params/1e6:.6f} M")
    print(f"Non-parameter buffers:      {param_report['non_parameter_buffers']/1e6:.6f} M")
    print(f"Trainable parameter ratio:  {param_report['trainable_percent']:.2f}%")
    print(f"Frozen parameter ratio:     {param_report['frozen_percent']:.2f}%")

    text_params = list(model.semantic_bank.text_encoder.parameters())
    text_param_ids = {id(p) for p in text_params}

    vision_params = [
        p for p in model.parameters()
        if p.requires_grad and id(p) not in text_param_ids
    ]

    optimizer = torch.optim.AdamW(
        [
            {
                "params": vision_params,
                "lr": LEARNING_RATE,
            },
            {
                "params": text_params,
                "lr": TEXT_LEARNING_RATE,
            },
        ],
        weight_decay=WEIGHT_DECAY,
        betas=(0.9, 0.999),
    )

    # Warm-up is implemented explicitly, followed by cosine decay.
    def set_epoch_lr(epoch_idx):
        if epoch_idx <= WARMUP_EPOCHS:
            scale = epoch_idx / max(1, WARMUP_EPOCHS)
        else:
            progress = (
                (epoch_idx - WARMUP_EPOCHS) /
                max(1, NUM_EPOCHS - WARMUP_EPOCHS)
            )
            scale = 0.5 * (1.0 + math.cos(math.pi * progress))

        scale = max(scale, MIN_LR / LEARNING_RATE)

        optimizer.param_groups[0]["lr"] = LEARNING_RATE * scale
        optimizer.param_groups[1]["lr"] = TEXT_LEARNING_RATE * scale

    scaler = torch.amp.GradScaler(
        "cuda",
        enabled=AMP_ENABLED,
    )

    history = []
    best_val_f1 = -np.inf
    patience_counter = 0

    checkpoint_path = (
        OUTPUT_DIR
        / f"{experiment_name}_seed{seed}_best.pt"
    )

    for epoch in range(1, NUM_EPOCHS + 1):
        set_epoch_lr(epoch)

        train_stats = train_one_epoch(
            model,
            train_loader,
            optimizer,
            scaler,
            class_weights=class_weights,
            epoch=epoch,
        )

        val_result = evaluate(
            model,
            val_loader,
            split_name=f"Validation epoch {epoch}",
        )

        val_f1 = val_result["metrics"]["macro_f1"]

        history.append({
            "epoch": epoch,
            "lr": optimizer.param_groups[0]["lr"],
            "text_lr": optimizer.param_groups[1]["lr"],
            **{
                f"train_{k}": v
                for k, v in train_stats.items()
            },
            **{
                f"val_{k}": v
                for k, v in val_result["metrics"].items()
            },
        })

        print(
            f"\nEpoch {epoch:03d} | "
            f"Train Acc={train_stats['accuracy']:.2f}% | "
            f"Val Acc={val_result['metrics']['accuracy']*100:.2f}% | "
            f"Val Macro-F1={val_f1:.4f}"
        )

        if val_f1 > best_val_f1:
            best_val_f1 = val_f1
            patience_counter = 0

            torch.save(
                {
                    "model_state": model.state_dict(),
                    "seed": seed,
                    "epoch": epoch,
                    "best_val_macro_f1": best_val_f1,
                    "config": {
                        "use_roi": use_roi,
                        "use_language": use_language,
                        "use_region_dropout": use_region_dropout,
                        "split_protocol": "global duplicate-aware image-level approximately 80/10/10",
                        "pretrained_visual_model": False,
                        "pretrained_language_model": False,
                        "training_mode": "entire_model_from_scratch",
                        "use_tta": USE_TTA,
                    },
                },
                checkpoint_path,
            )

            print(f"Saved best checkpoint: {checkpoint_path}")
        else:
            patience_counter += 1

        if patience_counter >= EARLY_STOPPING_PATIENCE:
            print(f"Early stopping at epoch {epoch}.")
            break

    save_history(
        history,
        OUTPUT_DIR
        / f"{experiment_name}_seed{seed}_history.csv",
    )

    # PyTorch 2.6+ defaults torch.load(..., weights_only=True).
    # This checkpoint was created by this trusted training script and
    # contains NumPy scalar metadata, so weights_only=True cannot unpickle it.
    # Load the trusted checkpoint with the legacy/full pickle behavior.
    try:
        checkpoint = torch.load(
            checkpoint_path,
            map_location=DEVICE,
            weights_only=False,
        )
    except TypeError:
        # Compatibility with older PyTorch versions that do not expose
        # the weights_only argument.
        checkpoint = torch.load(
            checkpoint_path,
            map_location=DEVICE,
        )

    model.load_state_dict(checkpoint["model_state"])

    train_result = evaluate(
        model,
        DataLoader(
            train_dataset,
            batch_size=BATCH_SIZE,
            shuffle=False,
            num_workers=NUM_WORKERS,
        ),
        "Train",
    )

    val_result = evaluate(model, val_loader, "Validation")

    # Copy the validation-selected model to a seed-specific checkpoint.
    # The test split is intentionally not evaluated inside this function.
    checkpoint_copy = OUTPUT_DIR / f"{experiment_name}_selected.pt"
    torch.save({
        "model_state": model.state_dict(),
        "seed": seed,
        "best_val_macro_f1": best_val_f1,
        "config": {
            "split_protocol": "global duplicate-aware image-level approximately 80/10/10",
            "pretrained_visual_model": False,
            "pretrained_language_model": False,
            "training_mode": "entire_model_from_scratch",
            "use_tta": USE_TTA,
        },
    }, checkpoint_copy)

    summary = {
        "experiment": experiment_name,
        "seed": seed,
        "split_protocol": "global duplicate-aware image-level approximately 80/10/10",
        "pretrained_visual_model": False,
        "pretrained_language_model": False,
        "training_mode": "entire_model_from_scratch",
        "use_tta": USE_TTA,
        "total_parameters_m": total_params / 1e6,
        "trainable_parameters_m": trainable_params / 1e6,
        "frozen_parameters_m": frozen_params / 1e6,
        "non_parameter_buffers_m": param_report["non_parameter_buffers"] / 1e6,
        "best_val_macro_f1": best_val_f1,
        "selected_checkpoint": str(checkpoint_copy),
        "test_evaluated_after_training": False,
    }

    with open(
        OUTPUT_DIR
        / f"{experiment_name}_seed{seed}_summary.json",
        "w",
    ) as f:
        json.dump(summary, f, indent=2)

    return summary


