class VisualEncoder(nn.Module):
    def __init__(self):
        super().__init__()

        self.roi_detector = SemanticROIDetector()

        # Hierarchical convolutional stem makes scratch optimization
        # substantially easier than projecting raw 224x224 pixels directly
        # into a 384-D token space.
        self.stem = nn.Sequential(
            nn.Conv2d(3, 64, kernel_size=7, stride=2, padding=3, bias=False),
            nn.BatchNorm2d(64),
            nn.GELU(),
            nn.Conv2d(64, 128, kernel_size=3, stride=2, padding=1, bias=False),
            nn.BatchNorm2d(128),
            nn.GELU(),
            nn.Conv2d(128, 192, kernel_size=3, stride=2, padding=1, bias=False),
            nn.BatchNorm2d(192),
            nn.GELU(),
        )
        self.scale28_proj = nn.Conv2d(192, VISION_DIM, kernel_size=1, bias=False)
        self.scale14_down = nn.Sequential(
            nn.Conv2d(192, VISION_DIM, kernel_size=3, stride=2, padding=1, bias=False),
            nn.BatchNorm2d(VISION_DIM),
            nn.GELU(),
        )

        # 224 -> 112 -> 56 -> 28 -> 14
        self.patch_pos = nn.Parameter(
            torch.zeros(1, 14, 14, VISION_DIM)
        )
        nn.init.trunc_normal_(self.patch_pos, std=0.02)

        self.swin_blocks = nn.ModuleList()

        for i in range(NUM_WINDOW_BLOCKS):
            shift = 0 if i % 2 == 0 else WINDOW_SIZE // 2

            self.swin_blocks.append(
                ShiftedWindowTransformerBlock(
                    dim=VISION_DIM,
                    num_heads=VISION_HEADS,
                    window_size=WINDOW_SIZE,
                    shift_size=shift,
                    mlp_dim=VISION_MLP_DIM,
                    dropout=0.1,
                )
            )

        self.cls_token = nn.Parameter(
            torch.randn(1, 1, VISION_DIM) * 0.02
        )

        self.region_embeddings = nn.Parameter(
            torch.randn(1, 3, VISION_DIM) * 0.02
        )

        self.global_blocks = nn.ModuleList([
            GlobalTransformerBlock(
                dim=VISION_DIM,
                num_heads=VISION_HEADS,
                mlp_dim=VISION_MLP_DIM,
                dropout=0.1,
            )
            for _ in range(NUM_GLOBAL_BLOCKS)
        ])

        self.final_norm = nn.LayerNorm(VISION_DIM)

    def masked_pool(self, feature_map, roi_map):
        """
        feature_map: [B,C,H,W]
        roi_map:     [B,1,H0,W0]
        """
        roi_map = F.interpolate(
            roi_map,
            size=feature_map.shape[-2:],
            mode="bilinear",
            align_corners=False,
        )

        weights = roi_map / (
            roi_map.sum(dim=(-2, -1), keepdim=True) + 1e-6
        )

        pooled = (feature_map * weights).sum(dim=(-2, -1))
        return pooled

    def forward(self, x, region_keep=None):
        """
        region_keep:
            None or [B,3] with 1=keep and 0=counterfactually mask.
        """
        roi_maps = self.roi_detector(x)

        stem28 = self.stem(x)
        feat14 = self.scale14_down(stem28)
        # Preserve medium-resolution anatomical information by pooling a
        # 28x28 feature map into the 14x14 token grid and adding it to the
        # high-level representation.
        scale28 = self.scale28_proj(stem28)
        scale28_to14 = F.adaptive_avg_pool2d(scale28, (14, 14))
        feat = feat14 + scale28_to14
        feat = feat.permute(0, 2, 3, 1)
        feat = feat + self.patch_pos

        for block in self.swin_blocks:
            feat = block(feat)

        feat_map = feat.permute(0, 3, 1, 2)

        region_tokens = []

        for idx, roi_map in enumerate(roi_maps):
            token = self.masked_pool(feat_map, roi_map)
            token = token.unsqueeze(1)
            region_tokens.append(token)

        region_tokens = torch.cat(region_tokens, dim=1)
        region_tokens = region_tokens + self.region_embeddings

        if region_keep is not None:
            region_tokens = (
                region_tokens *
                region_keep.unsqueeze(-1)
            )

        patch_tokens = feat_map.flatten(2).transpose(1, 2)

        B = x.shape[0]

        cls = self.cls_token.expand(B, -1, -1)

        tokens = torch.cat(
            [cls, region_tokens, patch_tokens],
            dim=1,
        )

        for block in self.global_blocks:
            tokens = block(tokens)

        tokens = self.final_norm(tokens)

        return {
            "tokens": tokens,
            "global": tokens[:, 0],
            "regions": tokens[:, 1:4],
            "roi_maps": roi_maps,
        }


# ================================================================
# 9. REGION-LANGUAGE GROUNDING
# ================================================================

class RegionLanguageGrounder(nn.Module):
    """
    Each learned ROI has its own two semantic concepts.

    hippocampus -> atrophy / preservation
    ventricle   -> enlargement / preservation
    cortex      -> atrophy / preservation
    """

    def __init__(self, dim=VISION_DIM, text_dim=TEXT_DIM):
        super().__init__()

        self.region_to_text = nn.Linear(dim, text_dim)

        self.text_to_visual = nn.Linear(text_dim, dim)

        self.semantic_norm = nn.LayerNorm(dim)

        self.gate = nn.Sequential(
            nn.Linear(dim * 2, dim),
            nn.GELU(),
            nn.Linear(dim, dim),
            nn.Sigmoid(),
        )

    def forward(self, region_tokens, semantic_bank, labels=None):
        B = region_tokens.shape[0]
        device = region_tokens.device

        fused_regions = []
        alignment_losses = []
        attribute_probs = []

        for region_idx, region_name in enumerate(REGION_NAMES):
            region = region_tokens[:, region_idx]

            visual_text_space = F.normalize(
                self.region_to_text(region),
                dim=-1,
            )

            text_proto = semantic_bank.region_embeddings(
                region_name,
                device,
            )

            text_proto = F.normalize(text_proto, dim=-1)

            similarity = (
                visual_text_space @ text_proto.t()
            ) / TEMPERATURE

            probs = torch.softmax(similarity, dim=-1)

            attribute_probs.append(probs)

            # The first phrase is the abnormality concept.
            # The second phrase is the preservation concept.
            # This is a semantic contrast, not a diagnostic label input.
            fused_text = (
                probs[:, 0:1] * text_proto[0:1] +
                probs[:, 1:2] * text_proto[1:2]
            )

            fused_text = self.text_to_visual(fused_text)

            gate = self.gate(
                torch.cat(
                    [region, fused_text],
                    dim=-1,
                )
            )

            fused = (
                gate * region +
                (1.0 - gate) * fused_text
            )

            fused = self.semantic_norm(fused)
            fused_regions.append(fused)

            # Class-aware contrastive region-semantic alignment.
            #
            # AD and MCI are encouraged toward the abnormality concept,
            # while CN is encouraged toward the preservation concept.
            # The diagnostic label is used as a training target only; it
            # is NOT supplied as an input to the model.
            #
            # This avoids the previous implementation's problem of forcing
            # every image, including CN, toward the abnormality concept.
            if labels is not None:
                labels = labels.to(device)
                target_index = torch.where(
                    labels == LABEL_MAP["CN"],
                    torch.ones_like(labels),
                    torch.zeros_like(labels),
                )
                align_loss = F.cross_entropy(similarity, target_index)
            else:
                # Safe fallback for inference/visualization.
                # No semantic alignment loss is applied without labels.
                align_loss = similarity.new_tensor(0.0)

            alignment_losses.append(align_loss)

        fused_regions = torch.stack(fused_regions, dim=1)

        return {
            "fused_regions": fused_regions,
            "alignment_loss": torch.stack(
                alignment_losses
            ).mean(),
            "attribute_probs": torch.stack(
                attribute_probs,
                dim=1,
            ),
        }


