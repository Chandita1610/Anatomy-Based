# 5. SEMANTICALLY ANCHORED ROI DETECTOR
# ================================================================

class SemanticROIDetector(nn.Module):
    """
    Three learned attention maps.

    Unlike the original implementation, the ROI maps are not simply
    averaged to one scalar. They are used to pool spatial visual
    features. Their specialization is encouraged by region-specific
    language concepts.
    """

    def __init__(self, in_channels=3):
        super().__init__()

        self.backbone = nn.Sequential(
            nn.Conv2d(in_channels, 32, 3, padding=1),
            nn.BatchNorm2d(32),
            nn.GELU(),

            nn.Conv2d(32, 64, 3, padding=1),
            nn.BatchNorm2d(64),
            nn.GELU(),

            nn.Conv2d(64, 32, 3, padding=1),
            nn.BatchNorm2d(32),
            nn.GELU(),
        )

        self.map_head = nn.Conv2d(32, 3, kernel_size=1)

    def forward(self, x):
        h = self.backbone(x)
        # Spatial softmax gives each learned ROI a stable probability
        # distribution over image locations.
        maps = self.map_head(h)
        maps = maps.flatten(2)
        maps = torch.softmax(maps, dim=-1)
        maps = maps.view(x.size(0), 3, x.size(2), x.size(3))

        return maps[:, 0:1], maps[:, 1:2], maps[:, 2:3]


# ================================================================
# 6. WINDOWED TRANSFORMER BLOCK
# ================================================================

def window_partition(x, window_size):
    """
    x: [B, H, W, C]
    returns [B*nW, window_size*window_size, C]
    """
    B, H, W, C = x.shape

    pad_h = (window_size - H % window_size) % window_size
    pad_w = (window_size - W % window_size) % window_size

    if pad_h or pad_w:
        x = x.permute(0, 3, 1, 2)
        x = F.pad(x, (0, pad_w, 0, pad_h))
        x = x.permute(0, 2, 3, 1)

    Hp, Wp = x.shape[1], x.shape[2]

    x = x.view(
        B,
        Hp // window_size,
        window_size,
        Wp // window_size,
        window_size,
        C,
    )

    windows = (
        x.permute(0, 1, 3, 2, 4, 5)
        .contiguous()
        .view(-1, window_size * window_size, C)
    )

    return windows, Hp, Wp


def window_reverse(windows, window_size, B, Hp, Wp, H, W):
    C = windows.shape[-1]

    x = windows.view(
        B,
        Hp // window_size,
        Wp // window_size,
        window_size,
        window_size,
        C,
    )

    x = (
        x.permute(0, 1, 3, 2, 4, 5)
        .contiguous()
        .view(B, Hp, Wp, C)
    )

    return x[:, :H, :W]


class MLPBlock(nn.Module):
    def __init__(self, dim, mlp_dim, dropout=0.1):
        super().__init__()

        self.net = nn.Sequential(
            nn.Linear(dim, mlp_dim),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(mlp_dim, dim),
            nn.Dropout(dropout),
        )

    def forward(self, x):
        return self.net(x)


class ShiftedWindowTransformerBlock(nn.Module):
    """
    Swin-style alternating regular and shifted windows.
    """

    def __init__(
        self,
        dim,
        num_heads,
        window_size=7,
        shift_size=0,
        mlp_dim=None,
        dropout=0.1,
    ):
        super().__init__()

        mlp_dim = mlp_dim or dim * 4

        self.window_size = window_size
        self.shift_size = shift_size

        self.norm1 = nn.LayerNorm(dim)
        self.attn = nn.MultiheadAttention(
            embed_dim=dim,
            num_heads=num_heads,
            dropout=dropout,
            batch_first=True,
        )

        self.norm2 = nn.LayerNorm(dim)
        self.mlp = MLPBlock(dim, mlp_dim, dropout)

    def forward(self, x):
        # x: [B,H,W,C]
        B, H, W, C = x.shape

        shortcut = x
        x_norm = self.norm1(x)

        if self.shift_size > 0:
            shifted = torch.roll(
                x_norm,
                shifts=(-self.shift_size, -self.shift_size),
                dims=(1, 2),
            )
        else:
            shifted = x_norm

        windows, Hp, Wp = window_partition(
            shifted,
            self.window_size,
        )

        attn_windows, _ = self.attn(
            windows,
            windows,
            windows,
            need_weights=False,
        )

        shifted_out = window_reverse(
            attn_windows,
            self.window_size,
            B,
            Hp,
            Wp,
            H,
            W,
        )

        if self.shift_size > 0:
            x = torch.roll(
                shifted_out,
                shifts=(self.shift_size, self.shift_size),
                dims=(1, 2),
            )
        else:
            x = shifted_out

        x = shortcut + x
        x = x + self.mlp(self.norm2(x))

        return x


# ================================================================
# 7. GLOBAL VISION TRANSFORMER BLOCK
# ================================================================

class GlobalTransformerBlock(nn.Module):
    def __init__(self, dim, num_heads, mlp_dim, dropout=0.1):
        super().__init__()

        self.norm1 = nn.LayerNorm(dim)
        self.attn = nn.MultiheadAttention(
            dim,
            num_heads,
            dropout=dropout,
            batch_first=True,
        )

        self.norm2 = nn.LayerNorm(dim)
        self.mlp = MLPBlock(dim, mlp_dim, dropout)

    def forward(self, x):
        y = self.norm1(x)
        y, _ = self.attn(y, y, y, need_weights=False)
        x = x + y
        x = x + self.mlp(self.norm2(x))
        return x


