        pred_table = pd.read_csv(pred_csv)
        for _, row in pred_table.iterrows():
            pred_lookup[str(row["path"])] = int(row["pred_label"])

    selected = []
    selected_tags = {}
    for class_idx, class_name in enumerate(CLASS_NAMES):
        class_indices = [
            i for i, label in enumerate(dataset.labels)
